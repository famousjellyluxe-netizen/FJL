# Server Configuration
NODE_ENV=production
PORT=3000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRY=24h
ADMIN_JWT_EXPIRY=7d

# Resend Email Configuration
RESEND_API_KEY=your-resend-api-key

# Store Configuration
STORE_NAME=Famous Jelly Luxe
STORE_EMAIL=Famous Jelly Luxe <hello@fjlclothing.shop>
TAX_RATE=7.5
SHIPPING_COST=0

# Bank Account Configuration
BANK_ACCOUNT_HOLDER=Famous Jelly Luxe Ltd
BANK_NAME=First Bank Nigeria
BANK_ACCOUNT_NUMBER=2058123456
BANK_CODE=011

# Email Configuration
ADMIN_EMAIL=admin@fjl.com
ORDER_CONFIRMATION_EMAIL=hello@fjlclothing.shop

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://fjl.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
